# FlowDocs - Environment example for server-side GitHub sync
# Copy this to .env (never commit real tokens)

# Enable/disable GitHub sync
GITHUB_SYNC_ENABLED=true

# GitHub credentials (server-only)
GITHUB_TOKEN=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
GITHUB_OWNER=isaias077
GITHUB_REPO=flowdocs-data

# Optional: if you previously used NEXT_PUBLIC_* remove them
NEXT_PUBLIC_GITHUB_TOKEN=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
NEXT_PUBLIC_GITHUB_OWNER=isaias077
NEXT_PUBLIC_GITHUB_REPO=flowdocs-data
NEXT_PUBLIC_GITHUB_SYNC_ENABLED=true
